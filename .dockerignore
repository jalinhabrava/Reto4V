# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Version control and editor state
.git
.git/**
.github
.vscode
.idea
*.swp

# Python local state
.venv
venv
__pycache__
*.py[cod]
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
dist
build
*.egg-info

# Node local state and generated bundles (the Docker build creates these in
# the frontend-build stage).
node_modules
frontend/node_modules
static/dist
frontend/dist
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data must live in named volumes, never in an image layer.
data
staticfiles
media
backups
certificates
*.sqlite3
*.dump
*.dump.gz
*.tar.gz
*.log

# Documentation and local artifacts are not required to run the service.
outputs
work
tmp
