{
	admin off
	auto_https off
}


{$CADDY_SITE_ADDRESS} {
	encode gzip
	reverse_proxy web:8000
}

# Local-only process check used by the container healthcheck.  It is not
# published by Compose and deliberately does not depend on the public site
# hostname or on TLS/SNI.
:8082 {
	respond /health "ok" 200
}
