[Unit]
Description=Programmy4V LAN containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/docker compose --project-directory @APP_DIR@ --env-file @APP_DIR@/.env up -d --no-build
ExecStop=/usr/bin/docker compose --project-directory @APP_DIR@ --env-file @APP_DIR@/.env stop
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
