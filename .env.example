# Reto4V deployment configuration
#
# `scripts/install.sh` creates this file for you on the first installation.
# If you copy it manually, generate two different values with:
#   openssl rand -hex 32
# Keep .env on the Linux filesystem, chmod 600, and never commit it.

COMPOSE_PROJECT_NAME=reto4v
COMPOSE_PROFILES=
RETO4V_IMAGE=reto4v:local

# Pin the major supported image here; an offline installation uses the exact
# image already cached on the host.  Pin a digest after the centre has tested
# an upgrade window.
POSTGRES_IMAGE=postgres:16-bookworm
CADDY_IMAGE=caddy:2-alpine

POSTGRES_DB=reto4v
POSTGRES_USER=reto4v
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_hex_value

DJANGO_SECRET_KEY=CHANGE_ME_generate_a_long_hex_value
DJANGO_DEBUG=0
# The installer replaces this with --host plus localhost/loopback aliases.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Use the browser URL, including scheme and port.  Change to https:// when
# using Caddy or another centre-managed TLS proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0

# Direct HTTP is deliberately loopback-only in this template: it is suitable
# for a smoke test, not for real student credentials or grades.  The installer
# sets APP_BIND_IP=0.0.0.0 for a LAN host, or keeps loopback with --proxy.
APP_BIND_IP=127.0.0.1
APP_PORT=8080

# Optional Caddy profile.  Caddy listens on :8080 inside its container and is
# exposed on CADDY_HTTP_PORT.  For internal TLS, use
# CADDYFILE=./Caddyfile.internal-tls and set CADDY_SITE_ADDRESS to the DNS
# name (for example reto4v.instituto.lan:8080); clients must trust Caddy's
# internal CA, or the centre must mount its own certificate configuration.
CADDYFILE=./Caddyfile
CADDY_BIND_IP=0.0.0.0
CADDY_HTTP_PORT=8081
CADDY_SITE_ADDRESS=:8080

TZ=Europe/Madrid
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
WAIT_FOR_DATABASE=1
DB_WAIT_RETRIES=30
HEALTHCHECK_PATH=/health/
