{
	admin off
}

# Caddy creates a local CA and a certificate for CADDY_SITE_ADDRESS.  Trust
# that CA on classroom clients, or replace `tls internal` with the centre's
# certificate/key configuration before using real student data.
{$CADDY_SITE_ADDRESS} {
	tls internal
	encode gzip
	reverse_proxy web:8000
}

# Local-only process check used by the container healthcheck.  It is not
# published by Compose and deliberately stays plain HTTP.
:8082 {
	respond /health "ok" 200
}
